[
	{
		"id": "SurveyChat",
		"type": "Chat",
		"_type": "Widget",
		"category": "Survey",
		"subcategory": "XFormInput",
		"name": "Survey Chat",
		"x": 0,
		"y": 0,
		"w": "320",
		"h": "400",
		"z": 0,
		"props": {
			"label": "Type a message",
			"isSurveyElement": true,
			"placeholder": false,
			"messageAsBubble": true,	
			"waitingTime": 1000,
			"value": [
				{					
					"type": "message",
					"role": "assistant",
					"content": "Hello there! \nThis is a survey about cars.\n**Do you own a car?**"
				}		
			],
			"responses": [
				{					
					"type": "message",
					"role": "assistant",
					"content": "How old are you?"
				},
                {					
					"type": "message",
					"role": "assistant",
					"content": "Do you consider buying a new car in the next year?"
				}				
			]					
		},
		"has": {
			"label": true,
			"backgroundColor": true,
			"border": true,
			"editable": true,
			"onclick": true,
			"padding": true
		},
		"style": {
			"fontSize": "@font-size-m",
			"fontFamily": "@font-family",
			"textAlign": "left",
			"letterSpacing": "@letterSpacing",
			"lineHeight": "@lineHeight",
			"background": "@form-background",
			"color": "@form-color",
			"borderRadius": "@border-radius",
			"borderWidth": "@border-width",
			"borderStyle": "solid",
			"borderColor": "@form-border-color",
			"paddingBottom": "@form-padding-horizontal",
			"paddingTop": "@form-padding-horizontal",
			"paddingLeft": "@form-padding-horizontal",
			"paddingRight": "@form-padding-horizontal",
			"messageUserBackground": "#cde5ff",
			"messageUserColor": "@form-color",
			"messageAssistantBackground": "#eeeeee",
			"messageAssistantColor": "@form-color",
			"messageButtonBackground": "@button-primary-background",
			"messageButtonColor": "@button-primary-color",
			"messageRadius": 8,
			"inputHeight": 64,
			"gap": 8
		},
		"focus": {
			"borderWidth": "@border-width:focus",
			"borderColor": "@form-border-color:focus",
			"background": "@form-background:focus",
			"color": "@form-color:focus"
		},
		"hover": {
			"borderColor": "@form-border-color:hover",
			"background": "@form-background:hover",
			"color": "@form-color:hover"
		}
	}
]