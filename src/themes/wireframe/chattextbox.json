[
	{
		"id": "ChatTextBox",
		"type": "ChatTextBox",
		"_type": "Widget",
		"category": "Advanced",
		"subcategory": "AFormInput",
		"name": "Chat TextBox",
		"x": 0,
		"y": 0,
		"w": "@form-width",
		"h": "@box-height-l",
